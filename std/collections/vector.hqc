//!
//! Standard Library dynamically-growing contiguous vector container.

namespace Exported {
    #include <CoreConcepts, ../core-concepts.hqc>
}
namespace Vector {
    namespace Iterator {
        /// @name It
        /// @generics
        /// ~@param T
        /// @summary Contiguous bidirectional iterator for Vector::Vec.
        class It<T> {
            T* data;
            int size;
            int current_index;
            /// @constructor
            /// @param data Pointer to the underlying vector buffer.
            /// @param size Number of active elements in the vector.
            /// @param is_end True to initialize at the end position, false for start.
            /// @summary Constructs an iterator over a contiguous vector buffer.
            It(T* data, int size, bool is_end) {
                this->data = data;
                this->size = size;
                this->current_index = `ternary(is_end, size, 0);
            }
            /// @name _atEnd
            /// @summary Returns true if the iterator has reached or passed the end.
            bool _atEnd() {
                return this->size <= this->current_index;
            }
            /// @name _next
            /// @summary Advances the iterator and returns the current element. Panics if empty.
            T _next() {
                if (this->size == 0) {
                    panic "attempted to iterate a empty vector";
                }
                if (!this->_atEnd()) {
                    return this->data[this->current_index++];
                }
                return this->data[this->size - 1];
            } 
            /// @name _atStart
            /// @summary Returns true if the iterator is at or before the start.
            bool _atStart() {
                return this->current_index <= 0;
            }
            /// @name _prev
            /// @summary Moves the iterator backward and returns the preceding element. Panics if empty.
            T _prev() {
                if (this->size == 0) {
                    panic "attempted to iterate a empty vector";
                }
                if (!this->_atStart()) {
                    return this->data[--this->current_index];
                }
                return this->data[this->current_index];
            }
            /// @name _moveTo
            /// @param index Target index to move the iterator to (clamped to valid bounds).
            /// @summary Moves the iterator to the specified index.
            void _moveTo(int index) {
                if (index >= this->size) {
                    index = this->size - 1;
                } else if (index < 0) {
                    index = 0;
                }
                this->current_index = index;
            }
        }
    }
    /// @name Vec
    /// @generics
    /// ~@param T
    /// @summary Heap-allocated dynamically resizing contiguous vector container.
    class Vec<T> {
        T* data;
        int size;
        int capacity;
        /// @constructor
        /// @summary Default constructor. Initializes an empty, unallocated vector.
        Vec() {
            this->size = 0;
            this->capacity = 0;
            this->data = nullptr;
        }
        /// @name reserve
        /// @param cap Target element capacity. Passing 0 frees the buffer and clears the vector.
        /// @summary Reallocates the underlying storage to hold cap elements.
        void reserve(int cap) {
            if (cap == 0) {
                `free(this->data);                
                this->data = nullptr;
                this->capacity = 0;
                this->size = 0;
                return;
            }

            T* new_data = `realloc(this->data, (sizeof T) * cap);
            if (new_data == nullptr) {
                return;
            }
            this->capacity = cap;
            if (this->size > this->capacity) {
                this->size = this->capacity;
            }
            this->data = new_data;
        }
        /// @name push
        /// @param value Element to append to the back of the vector.
        /// @summary Appends value, doubling capacity if full.
        void push(T value) {
            if (this->capacity <= this->size) {
                this->reserve(`ternary(this->capacity == 0, 1, this->capacity * 2));
                if (this->data == nullptr) return;
            }
            this->data[this->size] = value;
            this->size++;
        }
        /// @name length
        /// @summary Returns the number of elements currently stored in the vector.
        int length() {
            return this->size;
        }
        /// @name pop
        /// @summary Removes the last element from the vector if non-empty.
        void pop() {
            if (this->size > 0) {
                this->size--;
            }
        }
        /// @name shrinkToFit
        /// @summary Reallocates the underlying buffer to match the current element count.
        void shrinkToFit() {
            this->reserve(this->size);
        }
        /// @name operator[]=
        /// @param data Source buffer to copy from. Vec does not own.
        /// @param length Number of elements in data.
        /// @summary Replaces vector contents with length elements copied from data.
        void operator[]=(T* data, addr_t length) {
            if (this->capacity != 0) `free(this->data);
            this->capacity = length;
            this->size = length;
            this->data = `malloc((sizeof T) * this->capacity);
            for (int i = 0; i < this->size; i++) {
                this->data[i] = data[i];
            }
        }
        /// @indexing
        /// @param index Zero-based element index.
        /// @return Reference to the element at index.
        /// @summary Accesses the element at index.
        T& operator[](addr_t index) {
            return this->data[index];
        }
        /// @name _begin
        /// @summary Returns an iterator pointing to the first element.
        Iterator::It<T> _begin() {
            return Iterator::It<T>(this->data, this->size, false);
        }
        /// @name _end
        /// @summary Returns an iterator pointing past the last element.
        Iterator::It<T> _end() {
            return Iterator::It<T>(this->data, this->size, true);
        }
        /// @_destroy
        /// @inval this
        /// @summary Frees the underlying buffer and invalidates the vector.
        void _destroy() {
            `free(this->data);
            this->data = nullptr;
            this->size = -1;
            this->capacity = -1;
        }
        /// @assignment
        /// @param other Source vector to copy elements from. Vec does not own.
        /// @return Reference to this vector.
        /// @summary Deep-copies all elements from other into this vector.
        Vec<T>& operator=(Vec<T> other) {
            if (other.capacity != this->capacity) {
                this->reserve(other.capacity);
            }
            this->size = other.size;
            for (int i = 0; i < other.size; i++) {
                this->data[i] = other.data[i];
            }
            return this;
        }
        /// @name isEmpty
        /// @summary Returns true if the vector contains no elements.
        bool isEmpty() {
            return this->size == 0;
        }
    }
    Vec proves CoreConcepts::Allocated;
}
