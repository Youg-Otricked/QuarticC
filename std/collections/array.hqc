//!
//! Standard Library fixed-capacity and runtime-sized array container.

namespace Exported {
    #include <CoreConcepts, ../core-concepts.hqc>
}
namespace Array {
    namespace Iterator {
        /// @name It
        /// @generics
        /// ~@param T
        /// @summary Iterator for Array::Arr.
        class It<T> {
            T* data;
            int size;
            int current_index;
            /// @constructor
            /// @param data Pointer to the underlying array buffer.
            /// @param size Number of elements in the array.
            /// @param is_end True to initialize at the end position, false for start.
            /// @summary Constructs an iterator over an array buffer.
            It(T* data, int size, bool is_end) {
                this->data = data;
                this->size = size;
                this->current_index = `ternary(is_end, size, 0);
            }
            /// @name _atEnd
            /// @summary Returns true if the iterator has reached or passed the end.
            bool _atEnd() {
                return this->size <= this->current_index;
            }
            /// @name _next
            /// @summary Advances the iterator and returns the current element. Panics if empty.
            T _next() {
                if (this->size == 0) {
                    panic "attempted to iterate a empty array";
                }
                if (!this->_atEnd()) {
                    return this->data[this->current_index++];
                }
                return this->data[this->size - 1]; 
            } 
            /// @name _atStart
            /// @summary Returns true if the iterator is at or before the start.
            bool _atStart() {
                return this->current_index <= 0;
            }
            /// @name _prev
            /// @summary Moves the iterator backward and returns the preceding element. Panics if empty.
            T _prev() {
                if (this->size == 0) {
                    panic "attempted to iterate a empty array";
                }
                if (!this->_atStart()) {
                    return this->data[--this->current_index];
                }
                return this->data[this->current_index];
            }
            /// @name _moveTo
            /// @param index Target index to move the iterator to (clamped to valid bounds).
            /// @summary Moves the iterator to the specified index.
            void _moveTo(int index) {
                if (index >= this->size) {
                    index = this->size - 1;
                } else if (index < 0) {
                    index = 0;
                }
                this->current_index = index;
            }
        }
    }
    /// @name Arr
    /// @generics
    /// ~@param T
    /// ~@param S Optional compile-time maximum capacity (0 for unbounded).
    /// @summary Heap-allocated array container with optional static capacity cap.
    class Arr<T, int S = 0> {
        T* data;
        int size;
        /// @constructor
        /// @summary Default constructor. Initializes an empty, unallocated array.
        Arr() {
            this->data = nullptr;
            this->size = 0;
        }
        /// @name operator[]=
        /// @param data Source buffer to copy from. Arr does not own.
        /// @param length Number of elements in data.
        /// @summary Allocates and copies up to length (or S if S > 0) elements from data.
        void operator[]=(T* data, int length) {
            if (this->size != 0) `free(this->data);
            if (S == 0) {
                this->size = length;
            } else {
                this->size = `ternary((length > S), S, length);
            }
            this->data = `malloc((sizeof T) * this->size);
            for (int i = 0; i < this->size; i++) {
                this->data[i] = data[i];
            }
        }
        /// @indexing
        /// @param index The index to access.
        /// @return A reference to the element at index.
        /// @summary Indexes the array at index.
        T& operator[](addr_t index) {
            return this->data[index];
        }
        /// @name _begin
        /// @summary Returns an iterator pointing to the first element.
        Iterator::It<T> _begin() {
            return Iterator::It<T>(this->data, this->size, false);
        }
        /// @name _end
        /// @summary Returns an iterator pointing past the last element.
        Iterator::It<T> _end() {
            return Iterator::It<T>(this->data, this->size, true);
        }
        /// @_destroy
        /// @inval this
        /// @summary Frees the underlying array buffer.
        void _destroy() {
            `free(this->data);
            this->data = nullptr;
            this->size = -1;
        }
        /// @assignment
        /// @param other Source array to copy elements from. Arr does not own.
        /// @return Reference to this array.
        /// @summary Copies elements from other if sizes match.
        Arr<T, S>& operator=(Arr<T, S> other) {
            if (other.size != this->size) {
                return Arr();
            }
            for (int i = 0; i < other.size; i++) {
                this->data[i] = other.data[i];
            }
            return this;
        }
    }
    Arr proves CoreConcepts::Allocated;
}
