//!
//! Standard Library optional type.

namespace Optional {
    /// @name Optional
    /// @generics
    /// ~@param T
    /// @summary An optional value.
    class Option<T> {
        private T data;
        /// @name has_value
        /// @summary A boolean set to true if the class has a value.
        bool has_value;
        /// @constructor
        /// @summary Default constructor. Sets has_value to false.
        Option() {
            this->has_value = false;
        }
        /// @constructor
        /// @param value The value to store in the optional.
        /// @summary Value constructor. Sets has_value to true & the data to value.
        Option(T value) {
            this->data = value;
            this->has_value = true;
        }
        /// @name value
        /// @summary Returns a reference to the value. Panics if the value is not set.
        T& value() {
            if (!this->has_value) panic "no value in option";
            return this->data;
        }
        /// @name safeGet
        /// @param output A reference to T that is stored the result.
        /// @summary Returns false if there is no value stored, and otherwise sets output to data and returns true.
        bool safeGet(T& output) {
            if (!this->has_value) return false;
            output = this->data;
            return true;
        }
        /// @name setValue
        /// @param val A reference to T
        /// @summary Stores val in data & sets has_value to true.
        void setValue(T& val) {
            this->data = val;
            this->has_value = true;
        }
        /// @name removeValue
        /// @summary Sets has_value to false;
        void removeValue() {
            this->has_value = false;
        }
        /// @_eval
        /// @summary Evaluates to true if has_value is true.
        bool _eval() {
            return this->has_value;
        }
    }
}
