//!
//! Standard Library non-owning contiguous slice/span view.

namespace Span {
    namespace Iterator {
        /// @name It
        /// @generics
        /// ~@param T
        /// @summary Contiguous iterator for Span::Span.
        class It<T> {
            T* data;
            int size;
            int current_index;

            /// @constructor
            /// @param data Pointer to the underlying contiguous buffer.
            /// @param size Number of elements in the span.
            /// @param is_end True to initialize at the end position, false for start.
            /// @summary Constructs an iterator over a contiguous span.
            It(T* data, int size, bool is_end) {
                this->data = data;
                this->size = size;
                this->current_index = `ternary(is_end, size, 0);
            }

            /// @name _atEnd
            /// @summary Returns true if the iterator has reached or passed the end.
            bool _atEnd() {
                return this->size <= this->current_index;
            }

            /// @name _next
            /// @summary Advances the iterator and returns the current element. Panics if empty.
            T _next() {
                if (this->size == 0) {
                    panic "cannot iterate an empty";
                }
                if (!this->_atEnd()) {
                    return this->data[this->current_index++];
                }
                return this->data[this->size - 1];
            } 

            /// @name _atStart
            /// @summary Returns true if the iterator is at or before the start.
            bool _atStart() {
                return this->current_index <= 0;
            }

            /// @name _prev
            /// @summary Moves the iterator backward and returns the preceding element. Panics if empty.
            T _prev() {
                if (this->size == 0) {
                    panic "cannot iterate an empty";
                }
                if (!this->_atStart()) {
                    return this->data[--this->current_index];
                }
                return this->data[this->current_index];
            }

            /// @name _moveTo
            /// @param index Target index to move the iterator to (clamped to valid bounds).
            /// @summary Moves the iterator to the specified index.
            void _moveTo(int index) {
                if (index >= this->size) {
                    index = this->size - 1;
                } else if (index < 0) {
                    index = 0;
                }
                this->current_index = index;
            }
        }
    }

    /// @name Span
    /// @generics
    /// ~@param T
    /// @summary Non-owning view over a contiguous sequence of elements.
    class Span<T> {
        T* data;
        int length;

        /// @indexing
        /// @param index Zero-based element index.
        /// @return Reference to the element at index.
        /// @summary Bounds-checked access to the element at index.
        T& operator[](addr_t index) {
            if (index >= this->length) panic "Cannot index past end of a Span";
            return this->data[index];
        }

        /// @constructor
        /// @summary Default constructor. Initializes an empty span.
        Span() {
            this->length = 0;
            this->data = nullptr;
        }

        /// @name operator[]=
        /// @param data Pointer to contiguous elements. Span does not own.
        /// @param length Number of elements in data.
        /// @summary Rebinds the span to point to data with length elements without copying.
        void operator[]=(T *data, addr_t length) {
            this->length = length;
            this->data = data;
        }

        /// @name _begin
        /// @summary Returns an iterator pointing to the first element.
        Iterator::It<T> _begin() {
            return Iterator::It<T>(this->data, this->length, false);
        }

        /// @name _end
        /// @summary Returns an iterator pointing past the last element.
        Iterator::It<T> _end() {
            return Iterator::It<T>(this->data, this->length, true);
        }
    }
}
