//!
//! Standard Library core concepts. Contains most important concepts for interacting with standard types.
namespace Exported {
}
namespace CoreConcepts {
    /// @name Eq
    /// @summary Concept that requires equality comparisons on types.
    concept Eq {
        1_of {
            bool operator==(Self other);
            bool operator==(Self self, Self other);
        }
    }
    /// @name Allocated
    /// @summary Concept that requires cleanup methods on types.
    concept Allocated {
        at_least 1_of {
            void _destroy();
            void _destroy(Self self);
        }
    }
}
