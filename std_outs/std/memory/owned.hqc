//!
//! Standard Library owned type.

namespace Exported {
    #include <CoreConcepts, ../core-concepts.hqc>
}
namespace Owned {
    /// @name Owned
    /// @generics
    /// ~@param T
    /// @summary A owned value, meant to be used as the return type for a function.
    class Owned<T> {
        private T *data;
        /// @constructor
        /// @param data A pointer to heap memory
        /// @owns data
        /// @inval data for constructee
        /// @summary Initializes data.
        Owned(T *data) {
            this->data = data;
        }
        /// @name own
        /// @returns data
        /// @inval data for this 
        /// caller @owns data
        /// @summary Returns data & invalidates it for the class.
        T *own() {
            return this->data;
        }
        /// @name ignore
        /// @inval data
        /// @summary Frees data.
        void ignore() {
            `free(this->data);
            this->data = nullptr;
        }
        /// @name _destroy
        /// @inval data
        /// @summary Frees data.
        void _destroy() {
            `free(this->data);
        }
    }
    Owned proves CoreConcepts::Allocated;
}

